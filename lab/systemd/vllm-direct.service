[Unit]
Description=vLLM llama.cpp-compatible gateway on :8081 (front of vllm-engine.service; /opt/vllm/vllm_gateway.py)
BindsTo=vllm-engine.service
After=vllm-engine.service

[Service]
Type=simple
Environment=GW_ENGINE_UNIT=vllm-engine.service
Environment=GW_UPSTREAM=http://127.0.0.1:8000
Environment=GW_PORT=8081
Environment=GW_TOTAL_SLOTS=16
ExecStart=/root/vllm-venv-032/bin/python /opt/vllm/vllm_gateway.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
